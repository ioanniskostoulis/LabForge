    "purpose": "LaTeX report workspace",
    "wordmarkPath": "logo.txt",
    "versionSource": "VERSION",
    "port": 4185,
    "repository": "ioanniskostoulis/LabForge"
  },
  "document": {
    "noun": "report project",
    "plural": "report projects",
    "extension": "lfg",
    "containsMultipleFiles": true,
    "welcome": {
      "title": "No report open",
      "newLabel": "New report",
      "openLabel": "Open…",
      "detail": "Create or open a self-contained .lfg project"
    },
    "tabs": {
      "noun": "report project",
      "newTitle": "New report",
      "closeTitle": "Close report"
    }
  },
  "theme": {
    "dark": {
      "accent": "#e84c4c",
      "accentLight": "#e84c4c",
      "accentAbout": "#e84c4c",
      "accentFill": "#a82a2d",
      "accentHover": "#8e2225"
    },
    "light": {
      "accent": "#b92d30",
      "accentLight": "#b92d30",
      "accentAbout": "#b92d30",
      "accentFill": "#a82a2d",
      "accentHover": "#8e2225"
    }
  },
  "dataColors": [],
